NODE_ENV=development
APP_ENV=local
DATABASE_ENVIRONMENT=local
SECRETS_ENVIRONMENT=local
DATABASE_URL=postgresql://local:local@localhost:5432/bodegia_local
ACCESS_TOKEN_TTL_SECONDS=600
SESSION_ABSOLUTE_TTL_SECONDS=28800
PIN_LOCKOUT_SECONDS=900
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
PIN_PEPPER_CURRENT_VERSION=v1
PHONE_BINDING_HMAC_CURRENT_VERSION=v1
PHONE_BINDING_HMAC_KEYS_JSON={"v1":"replace-with-environment-secret"}
