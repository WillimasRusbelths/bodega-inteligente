{
  "name": "bodegia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint --config packages/config/eslint.config.js . --max-warnings=0",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,js,mjs,json}\" \"docs/architecture/**/*.md\" README.md package.json pnpm-workspace.yaml",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,js,mjs,json}\" \"docs/architecture/**/*.md\" README.md package.json pnpm-workspace.yaml",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm test:config && corepack pnpm test:security",
    "test:unit": "vitest run apps/api/test/unit --passWithNoTests --pool=threads --maxWorkers=1",
    "test:config": "vitest run apps/api/test/config --pool=threads --maxWorkers=1",
    "test:integration": "vitest run apps/api/test/integration --passWithNoTests --pool=threads --maxWorkers=1",
    "test:contract": "vitest run apps/api/test/contract --passWithNoTests --pool=threads --maxWorkers=1",
    "test:security": "vitest run apps/api/test/security --pool=threads --maxWorkers=1",
    "test:e2e:web": "playwright test apps/web/e2e/access-admin.spec.ts",
    "test:e2e:mobile": "maestro test apps/mobile/e2e",
    "test:performance": "k6 run apps/api/test/performance/access.js",
    "seed:demo": "node scripts/seed-demo.mjs",
    "build:api": "corepack pnpm --filter @bodegia/api build",
    "start:api": "corepack pnpm --filter @bodegia/api start:prod",
    "build:web": "corepack pnpm --dir apps/web build",
    "start:web": "corepack pnpm --dir apps/web start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.52.0",
    "@prisma/client": "6.19.0",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.4",
    "zod": "4.1.12"
  }
}
