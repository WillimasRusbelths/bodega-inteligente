{
  "name": "@bodegia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@bodegia/api-contract": "workspace:*",
    "@bodegia/authz-catalog": "workspace:*"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-static.mjs",
    "build:ts": "tsc",
    "dev": "corepack pnpm build:ts && node scripts/serve-demo.mjs",
    "preview": "node scripts/serve-demo.mjs",
    "start": "node scripts/serve-demo.mjs",
    "test": "corepack pnpm --dir ../.. exec vitest run apps/web/test --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "vercel-build": "corepack pnpm build"
  }
}
